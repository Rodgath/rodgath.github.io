  "main": "index.js",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/css/input.css -o ./dist/css/styles.css --minify",
    "watch:css": "npx tailwindcss -i ./src/css/input.css -o ./dist/css/styles.css --minify --watch",
    "copy:html": "shx cp src/index.html src/portfolio.html dist/",
    "copy:assets": "shx cp -r src/images src/js dist/",
    "clean": "shx rm -rf dist && shx mkdir -p dist/css",
    "watch": "gulp watch",
    "build": "gulp build"
  },
